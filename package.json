{
  "name": "@qa/playwright-typescript",
  "version": "1.0.0",
  "description": "Test automation framework with Playwright, TypeScript, and Jest — real E2E tests against a live app, mocked API tests, and an AI-assisted development workflow (see AGENTS.md)",
  "author": "Adolfo Han",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "scripts": {
    "test": "npm run test:api && npm run test:e2e",
    "test:api": "jest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:headed": "npm run test:e2e:headed",
    "test:smoke": "jest --testNamePattern='@smoke' && playwright test --grep @smoke",
    "test:regression": "jest --testNamePattern='@regression' && playwright test --grep @regression",
    "test:contract": "jest --testNamePattern='@contract'",
    "test:resilience": "jest --testNamePattern='@resilience'",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=lcov",
    "coverage": "jest --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "docker:build": "docker build -t qa-typescript-tests:latest .",
    "docker:test": "docker run --rm -v $(pwd)/coverage:/app/coverage -v $(pwd)/playwright-report:/app/playwright-report qa-typescript-tests:latest npm test"
  },
  "dependencies": {
    "@playwright/test": "^1.62.1",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "jest": "^29.7.0",
    "msw": "^2.10.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  }
}
